{{> head}}
  <div class="page">
    <h2 class="page-title">Добавление типа грунта</h2>

    {{#if soilType}}
      <form class="form" method="post" action="/soil_types/publish">
        <input type="hidden" name="id" value="{{soilType.id}}">

        <div class="field">
          <label class="field-label">Изображение</label>
          <div class="media-box">
            <img class="media-preview" src="{{soilType.imageUrl}}" alt="{{soilType.name}}">
            <span class="fake-file">Выбрать файл</span>
          </div>
        </div>

        <div class="field">
          <label class="field-label">Видео</label>
          <div class="media-box">
            <img class="media-preview" src="{{soilType.imageUrl}}" alt="{{soilType.name}}">
            <span class="fake-file">Выбрать файл</span>
          </div>
        </div>

        <div class="field">
          <label class="field-label" for="name">Название</label>
          <input class="input" id="name" type="text" value="{{soilType.name}}" readonly>
        </div>

        <div class="field">
          <label class="field-label" for="description">Описание</label>
          <textarea class="input textarea" id="description" name="description"
                    rows="4">{{soilType.description}}</textarea>
        </div>

        <div class="field">
          <label class="field-label" for="looseningFactor">Коэффициент разрыхления</label>
          <input class="input" id="looseningFactor" name="looseningFactor" type="text"
                 value="{{num2 soilType.looseningFactor}}">
        </div>

        <div class="field">
          <label class="field-label" for="density">Плотность, т/м³</label>
          <input class="input" id="density" name="density" type="text"
                 value="{{num2 soilType.density}}">
        </div>

        <button class="btn" type="submit">Опубликовать</button>
      </form>
    {{else}}
      <form class="form" method="post" action="/soil_types/create" enctype="multipart/form-data">
        <div class="field">
          <label class="field-label" for="image">Изображение</label>
          <div class="media-box">
            <img class="media-preview" src="/default.jpg" alt="Изображение по умолчанию">
            <input class="file-input" id="image" name="image" type="file" accept="image/*">
          </div>
        </div>

        <div class="field">
          <label class="field-label" for="video">Видео</label>
          <div class="media-box">
            <img class="media-preview" src="/default.jpg" alt="Видео по умолчанию">
            <input class="file-input" id="video" name="video" type="file" accept="video/*">
          </div>
        </div>

        <div class="field">
          <label class="field-label" for="name">Название</label>
          <input class="input" id="name" name="name" type="text" placeholder="Например, Торф" required>
        </div>

        <button class="btn" type="submit">Далее</button>
      </form>
    {{/if}}
  </div>
{{> tabbar}}
