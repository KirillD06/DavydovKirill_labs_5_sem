{{> head}}
  <div class="page">
    <h2 class="page-title">Добавление типа грунта</h2>

    <form class="form">
      <div class="field">
        <label class="field-label">Изображение</label>
        <div class="media-box">
          <img class="media-preview" src="{{mediaUrl}}/{{soilType.imageName}}" alt="{{soilType.name}}">
          <span class="fake-file">{{soilType.imageName}} · Выбрать файл</span>
        </div>
      </div>

      <div class="field">
        <label class="field-label">Видео</label>
        <div class="media-box">
          <img class="media-preview" src="{{mediaUrl}}/{{soilType.imageName}}" alt="{{soilType.name}}">
          <span class="fake-file">{{soilType.videoName}} · Выбрать файл</span>
        </div>
      </div>

      <div class="field">
        <label class="field-label" for="name">Название</label>
        <input class="input" id="name" type="text" value="{{soilType.name}}">
      </div>

      <div class="field">
        <label class="field-label" for="description">Краткое описание</label>
        <textarea class="input textarea" id="description" rows="3">{{soilType.shortDescription}}</textarea>
      </div>

      <div class="field">
        <label class="field-label" for="loosening">Коэффициент разрыхления</label>
        <input class="input" id="loosening" type="text" value="{{num2 soilType.looseningFactor}}">
      </div>

      <div class="field">
        <label class="field-label" for="density">Плотность, т/м³</label>
        <input class="input" id="density" type="text" value="{{num2 soilType.density}}">
      </div>
    </form>
  </div>
{{> tabbar}}
