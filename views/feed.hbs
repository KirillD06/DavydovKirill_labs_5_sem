{{> head}}
  {{#if soil}}
    <div class="feed">
      <video class="feed-video" src="{{mediaUrl}}/{{soil.videoName}}"
             poster="{{mediaUrl}}/{{soil.imageName}}"
             autoplay muted loop playsinline preload="auto"></video>
      <div class="feed-shade"></div>

      <div class="feed-body">
        <h1 class="feed-name">{{soil.name}}</h1>
        <p class="feed-short">{{soil.shortDescription}}</p>
        <details class="feed-details">
          <summary>Подробнее</summary>
          <p class="feed-full">{{soil.fullDescription}}</p>
        </details>
      </div>

      <div class="feed-side">
        <div class="feed-like">
          <svg class="heart" viewBox="0 0 24 24">
            <path d="M12 21c-.3 0-.6-.1-.8-.3C7.3 17.4 4 14.3 4 10.6 4 7.9 6 6 8.4 6c1.4 0 2.7.7 3.6 1.8C12.9 6.7 14.2 6 15.6 6 18 6 20 7.9 20 10.6c0 3.7-3.3 6.8-7.2 10.1-.2.2-.5.3-.8.3z"/>
          </svg>
          <span class="feed-like-count">{{soil.likes.length}}</span>
        </div>

        <span class="chip">Откос {{num2 soil.slopeRatio}}</span>
        <span class="chip">K разрыхления {{num2 soil.looseningFactor}}</span>

        <a class="btn feed-next" href="/soils/feed/{{soil.id}}?next=true">Следующий</a>
      </div>
    </div>
  {{else}}
    <p class="empty">Грунт не найден</p>
  {{/if}}
{{> tabbar}}
