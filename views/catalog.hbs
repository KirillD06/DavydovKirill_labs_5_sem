{{> head}}
  <div class="page">
    <h2 class="page-title">Типы грунтов</h2>

    <form class="filter" method="get" action="/soil_types">
      <label class="filter-label" for="maxLoosening">Коэффициент разрыхления не более</label>

      <div class="range">
        <input class="range-input" type="range" id="maxLoosening" name="maxLoosening"
               min="{{rangeFrom}}" max="{{rangeTo}}" step="0.01" value="{{maxLoosening}}">
        <span class="range-value">{{maxLooseningLabel}}</span>
      </div>

      <button class="btn btn-small" type="submit">Показать</button>
    </form>

    <div class="grid">
      {{#each soilTypes}}
        <div class="card">
          <a class="card-link" href="/soil_types/feed/{{this.id}}">
            <img class="card-image" src="{{this.imageUrl}}" alt="{{this.name}}">
            <div class="card-body">
              <div class="card-name">{{this.name}}</div>
              <div class="card-factor">K = {{num2 this.looseningFactor}}</div>
              <div class="card-factor">{{num2 this.density}} т/м³</div>
              <div class="card-likes">
                <svg class="heart" viewBox="0 0 24 24">
                  <path d="M12 21c-.3 0-.6-.1-.8-.3C7.3 17.4 4 14.3 4 10.6 4 7.9 6 6 8.4 6c1.4 0 2.7.7 3.6 1.8C12.9 6.7 14.2 6 15.6 6 18 6 20 7.9 20 10.6c0 3.7-3.3 6.8-7.2 10.1-.2.2-.5.3-.8.3z"/>
                </svg>
                {{this.likesCount}}
              </div>
            </div>
          </a>
          <form class="card-delete" method="post" action="/soil_types/delete">
            <input type="hidden" name="id" value="{{this.id}}">
            <button class="btn btn-small" type="submit">Удалить</button>
          </form>
        </div>
      {{else}}
        <p class="empty">Подходящих типов грунта нет</p>
      {{/each}}
    </div>
  </div>
{{> tabbar}}
