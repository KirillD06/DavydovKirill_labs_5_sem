{{> head}}
<div class="page">
  <h2 class="page-title">Вход в каталог грунтов</h2>
  {{#if user}}
    <p>Вы вошли как {{user.login}}.</p>
    <form class="form" method="post" action="/api/users/logout" data-auth><button class="btn" type="submit">Выйти</button></form>
  {{else}}
    <form class="form" method="post" action="/api/users/login" data-auth>
      <div class="field"><label class="field-label" for="login">Логин</label><input class="input" id="login" name="login" autocomplete="username" required maxlength="50"></div>
      <div class="field"><label class="field-label" for="password">Пароль</label><input class="input" id="password" name="password" type="password" autocomplete="current-password" required maxlength="100"></div>
      <button class="btn" type="submit">Войти</button>
    </form>
  {{/if}}
  <p data-auth-error role="alert" hidden></p>
  <p><a href="/soil_types">Каталог типов грунта</a></p>
</div>
<script src="/auth.js" defer></script>
{{> tabbar}}
